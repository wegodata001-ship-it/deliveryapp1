# Staging only. Copy to .env.staging and fill from a separate Supabase project.
# .env.staging is gitignored. Do not copy the production project into this file.
# Never commit passwords or keys. This process does not read .env.

WEGO_ENV=staging
WEGO_BLOCK_EXTERNAL_SIDE_EFFECTS=1

# All four identifiers below must belong to the same non-production project.
# DATABASE_URL: transaction pooler, port 6543, user postgres.<PROJECT_REF>
# DIRECT_URL: session pooler, port 5432, same user and project.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15&pool_timeout=15&connection_limit=3"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_URL="https://PROJECT_REF.supabase.co"

# Server-only. Leave blank until the staging project key exists.
# A JWT key is checked for the same project ref. Values are never printed.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Random strings, at least 16 characters. Not the production secrets.
SESSION_SECRET=
NEXTAUTH_SECRET=

# Test user created only by `npm run staging:preflight -- --create-test-user`.
# ADMIN role. The password is required and is not printed.
STAGING_TEST_USERNAME=staging-qa
STAGING_TEST_PASSWORD=

# Optional app settings used by the document and session code.
SUPABASE_DOCUMENTS_BUCKET=doc-atlas
SUPABASE_ORDERS_FOLDER=orders
SUPABASE_PAYMENTS_FOLDER=payments
SUPABASE_CUSTOMERS_FOLDER=customers
SUPABASE_REPORTS_FOLDER=reports
SIGNED_URL_EXPIRATION=3600
ALLOWED_UPLOADS=
MAX_UPLOAD_MB=20
ENABLE_DOCUMENT_AUDIT=true
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
E2E_BASE_URL=http://localhost:3000
E2E_ADMIN_USERNAME=staging-qa
E2E_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
SUPER_ADMIN_EMAIL=
CUSTOMER_CODE_FIRST_NUMBER=
PRISMA_CONNECTION_LIMIT=3

# There is no Stripe, SMS, or email provider in this codebase.
# Keep the block flag on so staging cannot be treated as a live notification target.
